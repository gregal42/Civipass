[Unit]
Description=Civipass — copie hors serveur des sauvegardes et des preuves de purge
OnFailure=civipass-failure@%n.service

[Service]
Type=oneshot
User=civipass
WorkingDirectory=/opt/civipass
EnvironmentFile=/etc/civipass/civipass.env
EnvironmentFile=-/etc/civipass/offsite.env
ExecStart=/opt/civipass/ops/backup/offsite-sync.sh all
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/civipass/var /var/backups/civipass /etc/civipass
