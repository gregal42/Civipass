# Paramètres de déploiement nginx de Civipass (VPS ou serveur dédié, une seule instance). Copier en `civipass.env`, adapter, puis :
#   ops/nginx/bin/render.sh --env civipass.env --out /chemin/de/sortie
# Format : CLE=valeur, une par ligne, sans guillemets ni expressions (le fichier n'est jamais exécuté). Voir ops/nginx/README.md.

# --- À REMPLACER avant tout déploiement ---------------------------------------------------------------------------------------------------
# Nom de domaine public. `civipass.example` est un domaine d'EXEMPLE : render.sh refuse de le déployer (option --allow-example réservée aux tests).
CIVIPASS_DOMAIN=civipass.example
TLS_CERTIFICATE=/etc/letsencrypt/live/civipass.example/fullchain.pem
TLS_CERTIFICATE_KEY=/etc/letsencrypt/live/civipass.example/privkey.pem
# Racine web de l'application (le dossier `public/` de Symfony, jamais la racine du projet).
DOCROOT=/var/www/civipass/current/public
# PHP-FPM : socket unix (recommandé) ou hôte:port.
PHP_FPM_UPSTREAM=unix:/run/php/php8.4-fpm-civipass.sock

# --- Valeurs par défaut raisonnables -------------------------------------------------------------------------------------------------------
# Dossier des journaux Civipass. Distinct de /var/log/nginx pour que la rotation du paquet nginx (/etc/logrotate.d/nginx, glob *.log) ne touche pas ces fichiers.
LOG_DIR=/var/log/civipass/nginx
# Rétentions (configurables) : journaux d'accès (jours), journal d'erreur assaini (heures : 168 = 7 jours, une rotation par heure).
ACCESS_LOG_RETENTION_DAYS=30
ERROR_LOG_RETENTION_HOURS=168
# Utilisateur des processus nginx (Debian/Ubuntu : www-data ; dépôt nginx.org : nginx) et groupe d'administration autorisé à lire les journaux.
NGINX_USER=www-data
ADMIN_GROUP=adm
NGINX_PID_FILE=/run/nginx.pid
# Emplacements d'installation des scripts (voir README).
SANITIZER_PATH=/usr/local/sbin/civipass-sanitize-nginx-error
HOOK_PATH=/usr/local/sbin/civipass-nginx-log-hook
# Fichier d'état de logrotate (rotation horaire dédiée).
LOGROTATE_STATE=/var/lib/civipass/logrotate-nginx.status
LOGROTATE_CONF=/etc/civipass/nginx/logrotate.conf
