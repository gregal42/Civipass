# Site Civipass (domaine : __CIVIPASS_DOMAIN__). Généré par ops/nginx/bin/render.sh : NE PAS éditer à la main.

# Hôte inconnu : refusé (jamais de redirection construite avec `$host`, qui est fourni par le client).
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name _;
    ssl_reject_handshake on;
}

# HTTP : redirection vers l'adresse FIXE configurée. Un secret n'est jamais censé arriver ici (les QR et les liens sont émis en https:// à partir de DEFAULT_URI).
server {
    listen 80;
    listen [::]:80;
    server_name __CIVIPASS_DOMAIN__;

    set $civ_path $civ_path;
    if ($civ_path = "") { set $civ_path $uri; }

    location / {
        return 301 https://__CIVIPASS_DOMAIN__$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __CIVIPASS_DOMAIN__;

    ssl_certificate     __TLS_CERTIFICATE__;
    ssl_certificate_key __TLS_CERTIFICATE_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:civipass_ssl:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # HSTS : un an, sans sous-domaines ni préchargement. ATTENTION : un `add_header` placé dans un `location` SUPPRIME les en-têtes hérités du `server` ;
    # n'en mettre dans aucun `location` (ou y répéter celui-ci). Contrôlé par ops/nginx/tests/verify-nginx.sh.
    add_header Strict-Transport-Security "max-age=31536000" always;

    root __DOCROOT__;

    # Chemin d'origine pour le journal (voir 00-civipass-logging.conf).
    set $civ_path $civ_path;
    if ($civ_path = "") { set $civ_path $uri; }

    # Fichiers cachés (hors .well-known) : jamais servis ni transmis à PHP.
    location ~ /\.(?!well-known/) {
        return 404;
    }

    # Ressources statiques ; absentes, elles tombent sur Symfony. Aucun add_header ici (voir HSTS).
    location ~* "\.(?:jpg|jpeg|gif|png|ico|svg|svgz|webp|css|js|woff2?|ttf|otf|eot|map)$" {
        expires 1M;
        access_log off;
        try_files $uri /index.php$is_args$args;
    }

    location / {
        try_files $uri /index.php$is_args$args;
    }

    # Seul le contrôleur frontal est exécuté, et jamais directement depuis l'extérieur (`internal`).
    location ~ ^/index\.php(/|$) {
        fastcgi_pass __PHP_FPM_UPSTREAM__;
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        # nginx est le premier saut : l'adresse du client est REMOTE_ADDR. Aucun en-tête de provenance fourni par un client n'est transmis à PHP, même si
        # SYMFONY_TRUSTED_PROXIES était un jour mal configuré (le contournement des limiteurs a été reproduit sans cette protection).
        fastcgi_param HTTP_X_FORWARDED_FOR "";
        fastcgi_param HTTP_X_FORWARDED_HOST "";
        fastcgi_param HTTP_X_FORWARDED_PROTO "";
        fastcgi_param HTTP_X_FORWARDED_PORT "";
        fastcgi_param HTTP_X_FORWARDED_PREFIX "";
        fastcgi_param HTTP_FORWARDED "";
        fastcgi_param HTTP_X_REAL_IP "";
        internal;
    }

    # Tout autre fichier PHP : introuvable.
    location ~ \.php$ {
        return 404;
    }
}
