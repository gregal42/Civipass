# NON ACTIVÉ — livré dans optional/ : ne l'installer qu'après les validations nécessaires (voir README).
[Unit]
Description=Civipass — PURGE RÉELLE (destructive ; exige l'interrupteur de purge activé)
OnFailure=civipass-failure@%n.service

[Service]
Type=oneshot
User=civipass
WorkingDirectory=/opt/civipass
EnvironmentFile=/etc/civipass/civipass.env
ExecStart=/opt/civipass/ops/bin/run-job retention-purge --timeout 3600 -- /usr/bin/php /opt/civipass/bin/console app:retention:purge --execute
SuccessExitStatus=75
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/civipass/var
