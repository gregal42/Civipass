# Activation automatique des événements à l'heure de début (DM-123). Livré, jamais installé par le dépôt (voir README).
[Unit]
Description=Civipass — activation des événements dont l'heure de début est atteinte
OnFailure=civipass-failure@%n.service

[Service]
Type=oneshot
User=civipass
WorkingDirectory=/opt/civipass
EnvironmentFile=/etc/civipass/civipass.env
ExecStart=/opt/civipass/ops/bin/run-job event-activation --timeout 120 -- /usr/bin/php /opt/civipass/bin/console app:event:activate-due
SuccessExitStatus=75
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/civipass/var
