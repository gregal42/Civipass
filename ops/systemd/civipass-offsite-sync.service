[Unit]
Description=Civipass — copie hors serveur des sauvegardes chiffrées et des preuves de purge
OnFailure=civipass-failure@%n.service

[Service]
Type=oneshot
User=civipass
WorkingDirectory=/opt/civipass
EnvironmentFile=/etc/civipass/civipass.env
EnvironmentFile=-/etc/civipass/offsite.env
ExecStart=/opt/civipass/ops/bin/run-job offsite-sync --timeout 1800 -- /opt/civipass/ops/backup/offsite-sync.sh all
SuccessExitStatus=75
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/civipass/var
ReadOnlyPaths=/var/backups/civipass /etc/civipass
