[Unit]
Description=Civipass — simulation de purge (aucune écriture)
OnFailure=civipass-failure@%n.service

[Service]
Type=oneshot
User=civipass
WorkingDirectory=/opt/civipass
EnvironmentFile=/etc/civipass/civipass.env
ExecStart=/opt/civipass/ops/bin/run-job purge-simulation --timeout 1800 -- /usr/bin/php /opt/civipass/bin/console app:retention:purge --limit 500
SuccessExitStatus=75
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/civipass/var
