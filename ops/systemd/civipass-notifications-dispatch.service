[Unit]
Description=Civipass — distributeur de notifications
OnFailure=civipass-failure@%n.service

[Service]
Type=oneshot
User=civipass
WorkingDirectory=/opt/civipass
EnvironmentFile=/etc/civipass/civipass.env
ExecStart=/opt/civipass/ops/bin/run-job notifications-dispatch --timeout 120 -- /usr/bin/php /opt/civipass/bin/console app:notifications:dispatch
SuccessExitStatus=75
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/civipass/var
