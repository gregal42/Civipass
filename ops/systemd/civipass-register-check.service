[Unit]
Description=Civipass — cohérence du registre de purge (lecture seule)
OnFailure=civipass-failure@%n.service

[Service]
Type=oneshot
User=civipass
WorkingDirectory=/opt/civipass
EnvironmentFile=/etc/civipass/civipass.env
ExecStart=/opt/civipass/ops/bin/run-job register-check --timeout 900 -- /usr/bin/php /opt/civipass/bin/console app:retention:register-check
SuccessExitStatus=75
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/civipass/var
