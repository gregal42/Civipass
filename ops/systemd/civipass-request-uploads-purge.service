[Unit]
Description=Civipass — purge des justificatifs temporaires abandonnés (> 24 h, jamais les pièces des dossiers)
OnFailure=civipass-failure@%n.service

[Service]
Type=oneshot
User=civipass
WorkingDirectory=/opt/civipass
EnvironmentFile=/etc/civipass/civipass.env
ExecStart=/opt/civipass/ops/bin/run-job request-uploads-purge --timeout 300 -- /usr/bin/php /opt/civipass/bin/console app:request-uploads:purge
SuccessExitStatus=75
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/civipass/var
