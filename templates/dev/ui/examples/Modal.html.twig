<button type="button" class="cp-btn cp-btn--secondary" data-modal-open="demo-modal">{% include 'components/icon.html.twig' with { name: 'file' } only %}<span>Consulter attestation-domicile.pdf</span></button>
{% embed 'components/modal.html.twig' with { id: 'demo-modal', title: 'attestation-domicile.pdf', size: 'wide', has_foot: true } only %}
