    {% include 'components/zone_card.html.twig' with { id: 'b2', name: 'Lotissement des Cigales', type: 'Quartier', status: 'active', commune: 'Le Temple', select: { name: 'zones[]', value: 'b2' }, validity_empty: 'Elle n’ouvre aucun droit d’accès tant que sa validité n’est pas configurée.' } only %}
    {% include 'components/zone_card.html.twig' with { id: 'b3', name: 'Chemin du lac', type: 'Rue', status: 'active', commune: 'Le Temple', select: { name: 'zones[]', value: 'b3' } } only %}
