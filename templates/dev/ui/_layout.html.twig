{#
  Layout de la galerie de prévisualisation du design system (/dev/ui, environnement dev uniquement).
  Variables : theme (« light » | « dark » | vide = réglage du système).   Blocs : title, content.
#}
<!doctype html>
<html lang="fr"{% if theme|default('') %} data-theme="{{ theme }}"{% endif %}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <meta name="turbo-cache-control" content="no-cache">
  <title>{% block title %}Design system{% endblock %} · Prévisualisation Civipass</title>
  <link rel="stylesheet" href="{{ asset('styles/civipass/tokens.css') }}">
  <link rel="stylesheet" href="{{ asset('styles/civipass/civipass.css') }}">
  <link rel="stylesheet" href="{{ asset('styles/civipass-app.css') }}">
  {{ importmap('app') }}
</head>
<body class="cp-root">
  <a class="cp-skip" href="#main">Aller au contenu</a>
  {% include 'components/banner.html.twig' with { variant: 'info', text: 'Prévisualisation du design system — environnement de développement : données fictives, aucune action n’est enregistrée.' } only %}
  <main id="main" class="dev-ui" tabindex="-1">{% block content %}{% endblock %}</main>
</body>
</html>
