{% extends 'layouts/app.html.twig' %}
{% set participation_labels = { INVITED: 'Invitée', ACTIVE: 'Active', SUSPENDED: 'Suspendue', CLOSED: 'Clôturée' } %}
{% set participation_pills = { INVITED: 'invited', ACTIVE: 'active', SUSPENDED: 'suspended', CLOSED: 'closed' } %}
{% set status_key = detail.status.value|lower %}
{% set rel = detail.relation.value %}
{% set tz = detail.timezone %}
{% set life = detail.lifecycle %}

{% block content %}
  {% import 'municipal/event/_actions.html.twig' as act %}
  {% include 'municipal/event/_head.html.twig' with { current: 'fiche' } %}

  <div class="app-split">
    <div class="app-stack">

      {% if rel == 'invited' %}
        {% set invitation = detail.participants.invitation %}
        <section class="cp-section" aria-labelledby="inv-h">
          {% include 'components/section_head.html.twig' with { id: 'inv-h', title: 'Invitation de ' ~ detail.organizerMunicipalityName, meta: invitation and invitation.invitedAt ? 'Reçue le ' ~ invitation.invitedAt|cp_datetime(tz) : '' } only %}
          {% if invitation and invitation.invitationMessage %}<blockquote class="cp-invite__msg" style="margin: 0">« {{ invitation.invitationMessage }} »</blockquote>{% endif %}
          {% set acceptable = detail.visibleAction(constant('App\\Event\\Application\\Read\\EventAction::AcceptInvitation')) %}
          {% if acceptable and acceptable.allowed %}
            <ul class="cp-consequences">
              {% for c in ['Votre commune devient participante de cet événement : la participation est active immédiatement.', 'Participer ne donne pas le droit de créer vos propres événements.', 'Aucun abonnement n’est nécessaire pour participer.'] %}<li>{% include 'components/icon.html.twig' with { name: 'right', size: 's' } only %}<span>{{ c }}</span></li>{% endfor %}
            </ul>
            <form method="post" action="{{ path('app_municipal_participation_action', { municipalityId: active_municipality_id, eventId: detail.eventId, action: 'accepter' }) }}" novalidate data-controller="cp--submit-state">
              <input type="hidden" name="_token" value="{{ csrf_token('participation_accepter_' ~ detail.eventId) }}">
              <div class="cp-form-actions">{% include 'components/button.html.twig' with { label: 'Accepter l’invitation', icon: 'check', type: 'submit', loading_label: 'Acceptation…' } only %}</div>
            </form>
          {% endif %}
          {% set accept = detail.action(constant('App\\Event\\Application\\Read\\EventAction::AcceptInvitation')) %}
          {% if accept and not accept.allowed and accept.reason.value == 'ROLE_NOT_ALLOWED' %}<p class="app-note">Seul un administrateur communal peut accepter cette invitation.</p>{% endif %}
          <p class="app-note">L’invitation n’expire pas. Le refus d’une invitation n’est pas prévu en V1.</p>
        </section>
      {% else %}
        <section class="cp-section" aria-labelledby="desc-h">
          {% include 'components/section_head.html.twig' with { id: 'desc-h', title: 'Description' } only %}
          <p class="app-lead">{{ detail.description ?: 'Aucune description.' }}</p>
        </section>
        {% if detail.operationalInstructions %}
          <section class="cp-section" aria-labelledby="instr-h">
            {% include 'components/section_head.html.twig' with { id: 'instr-h', title: 'Consignes opérationnelles', meta: 'Commune organisatrice' } only %}
            <p class="app-lead" style="white-space: pre-line">{{ detail.operationalInstructions }}</p>
          </section>
        {% endif %}
      {% endif %}

      {% set visibility = detail.participants.visibility.value %}
      {% if visibility in ['FULL', 'COORDINATION', 'HISTORY'] or detail.participants.details|length or detail.participants.summaries|length or detail.participants.history|length %}
        <section class="cp-section" id="communes" aria-labelledby="communes-h">
          {% include 'components/section_head.html.twig' with { id: 'communes-h', title: 'Communes', meta: detail.participants.participatingCount is not null ? detail.participants.participatingCount ~ ' participante(s)' : '' } only %}
          {% set rows = [] %}
          {% for d in detail.participants.details %}
            {% set pill %}{% include 'components/status_pill.html.twig' with { status: participation_pills[d.status.value], label: participation_labels[d.status.value] } only %}{% endset %}
            {% set rows = rows|merge([{ cells: { name: { text: d.municipalityName ~ (d.organizer ? ' · organisatrice' : '') }, status: { html: pill } } }]) %}
          {% endfor %}
          {% for s in detail.participants.summaries %}
            {% set pill %}{% include 'components/status_pill.html.twig' with { status: participation_pills[s.status.value], label: participation_labels[s.status.value] } only %}{% endset %}
            {% set rows = rows|merge([{ cells: { name: { text: s.municipalityName ~ (s.organizer ? ' · organisatrice' : '') }, status: { html: pill } } }]) %}
          {% endfor %}
          {% for h in detail.participants.history %}
            {% set rows = rows|merge([{ cells: { name: { text: h.municipalityName ~ (h.organizer ? ' · organisatrice' : '') }, status: { text: 'A participé' } } }]) %}
          {% endfor %}
          {% include 'components/data_table.html.twig' with {
            caption: 'Communes liées à cet événement',
            columns: [{ key: 'name', label: 'Commune', card: 'title' }, { key: 'status', label: 'Participation', card: 'status' }],
            rows: rows, empty: 'Aucune commune',
          } only %}
        </section>
      {% endif %}

      {% if rel == 'participant' and detail.myParticipationStatus %}
        <section class="cp-section" aria-labelledby="mine-h">
          {% include 'components/section_head.html.twig' with { id: 'mine-h', title: 'Votre participation', meta: active_municipality_name } only %}
          <div class="app-item">
            <div class="app-item__head"><span class="app-item__name">{{ active_municipality_name }}</span>{% include 'components/status_pill.html.twig' with { status: participation_pills[detail.myParticipationStatus.value], label: participation_labels[detail.myParticipationStatus.value] } only %}</div>
          </div>
          <div class="cp-cluster">{% include 'components/button.html.twig' with { label: 'Gérer ma participation', href: communes_url ~ '#ma-participation', variant: 'secondary', icon: 'users' } only %}</div>
        </section>
      {% endif %}

      {% set A = 'App\\Event\\Application\\Read\\EventAction::' %}
      {% set activate = detail.visibleAction(constant(A ~ 'Activate')) %}
      {% set suspend = detail.visibleAction(constant(A ~ 'Suspend')) %}
      {% set reactivate = detail.visibleAction(constant(A ~ 'Reactivate')) %}
      {% set close = detail.visibleAction(constant(A ~ 'Close')) %}
      {% set lc = { municipalityId: active_municipality_id, eventId: detail.eventId } %}

      {% if rel == 'organizer' and detail.activationReady is not null and activate %}
        <section class="cp-section" id="activation" aria-labelledby="act-h" data-controller="cp--disclosure">
          {% include 'components/section_head.html.twig' with { id: 'act-h', title: 'Activation' } only %}
          <ul class="app-checklist">
            <li class="{{ detail.activationReady ? 'is-ok' : 'is-todo' }}">
              {% include 'components/icon.html.twig' with { name: detail.activationReady ? 'check' : 'alert', size: 's' } only %}
              <span>{{ detail.activationReady ? 'Au moins une zone confirmée, active et configurée : l’événement peut être activé.' : 'Aucune zone n’est prête : confirmez au moins une zone active et configurez sa validité.' }}</span>
            </li>
          </ul>
          <div class="cp-cluster" style="gap: var(--space-4); align-items: flex-start">
            {% if activate.allowed and detail.activationReady %}
              {% include 'components/button.html.twig' with { label: 'Activer l’événement…', icon: 'zap', variant: 'primary', attrs: 'data-action="cp--disclosure#open" data-cp--disclosure-panel-param="lactivate" data-cp--disclosure-target="trigger" aria-expanded="false"' } only %}
            {% else %}
              {% include 'components/button.html.twig' with { id: 'act-activate', label: 'Activer l’événement', icon: 'zap', variant: 'primary', unavailable_reason: activate.allowed ? 'Confirmez au moins une zone active et configurez sa validité.' : cp_denial_message(activate.reason) } only %}
            {% endif %}
            {% if activate.allowed %}<a href="{{ zones_url }}">Gérer les zones</a>{% endif %}
          </div>
          {% if activate.allowed and detail.activationReady %}
            <div data-cp--disclosure-target="panel" data-panel="lactivate"{{ open_panel == 'lactivate' ? '' : ' hidden' }}>
              {% embed 'components/confirm_panel.html.twig' with {
                id: 'lactivate', title: 'Activer « ' ~ detail.name ~ ' »', confirm_label: 'Activer l’événement', loading_label: 'Activation…',
                action: path('app_municipal_event_lifecycle', lc|merge({ action: 'activer' })),
                consequences: ['L’événement passe de « Brouillon » à « Actif » : ses zones confirmées, actives et configurées deviennent opérationnelles.'],
                keeps: ['Après l’activation, le type, le fuseau horaire, la date de début et la référence ne peuvent plus être modifiés.', 'L’événement reste suspendable, puis réactivable, jusqu’à sa clôture.'],
                cancel_attrs: 'data-action="cp--disclosure#close"', token: csrf_token('event_lifecycle_activer_' ~ detail.eventId), problem: problem|default(''),
              } only %}
                {% block fields %}<input type="hidden" name="_token" value="{{ token }}">{% if problem %}{% include 'components/alert.html.twig' with { variant: 'error', title: 'Activation impossible', text: problem } only %}{% endif %}{% endblock %}
              {% endembed %}
            </div>
          {% endif %}
        </section>
      {% endif %}

      {% if rel == 'organizer' and (suspend or reactivate or close) %}
        <section class="cp-section" id="cycle" aria-labelledby="life-h" data-controller="cp--disclosure">
          {% include 'components/section_head.html.twig' with { id: 'life-h', title: 'Suspension et clôture', meta: 'Commune organisatrice' } only %}
          <div class="cp-cluster" style="gap: var(--space-4); align-items: flex-start">
            {% if suspend %}
              {% if suspend.allowed %}{% include 'components/button.html.twig' with { label: 'Suspendre l’événement…', icon: 'alert', variant: 'secondary', attrs: 'data-action="cp--disclosure#open" data-cp--disclosure-panel-param="lsuspend" data-cp--disclosure-target="trigger" aria-expanded="false"' } only %}
              {% else %}{% include 'components/button.html.twig' with { id: 'act-suspend', label: 'Suspendre l’événement', variant: 'secondary', unavailable_reason: cp_denial_message(suspend.reason) } only %}{% endif %}
            {% endif %}
            {% if reactivate and reactivate.allowed %}
              <form method="post" action="{{ path('app_municipal_event_lifecycle', lc|merge({ action: 'reactiver' })) }}" novalidate data-controller="cp--submit-state">
                <input type="hidden" name="_token" value="{{ csrf_token('event_lifecycle_reactiver_' ~ detail.eventId) }}">
                {% include 'components/button.html.twig' with { label: 'Réactiver l’événement', icon: 'refresh', type: 'submit', variant: 'secondary', loading_label: 'Réactivation…' } only %}
              </form>
            {% endif %}
            {% if close %}
              {% if close.allowed %}{% include 'components/button.html.twig' with { label: 'Clôturer l’événement…', variant: 'danger-ghost', attrs: 'data-action="cp--disclosure#open" data-cp--disclosure-panel-param="lclose" data-cp--disclosure-target="trigger" aria-expanded="false"' } only %}
              {% else %}{% include 'components/button.html.twig' with { id: 'act-close', label: 'Clôturer l’événement', variant: 'danger-ghost', unavailable_reason: cp_denial_message(close.reason) } only %}{% endif %}
            {% endif %}
          </div>
          <p class="app-note">La clôture est définitive : elle clôture aussi toutes les participations.</p>

          {% if suspend and suspend.allowed %}
            <div data-cp--disclosure-target="panel" data-panel="lsuspend"{{ open_panel == 'lsuspend' ? '' : ' hidden' }}>
              {% embed 'components/confirm_panel.html.twig' with {
                id: 'lsuspend', title: 'Suspendre l’événement', confirm_label: 'Suspendre l’événement', loading_label: 'Suspension…',
                action: path('app_municipal_event_lifecycle', lc|merge({ action: 'suspendre' })),
                consequences: ['L’événement n’est plus actif : ses zones n’ouvrent plus de droits tant qu’il est suspendu.'],
                keeps: ['Les participations des communes ne sont pas suspendues.', 'Vous pourrez réactiver l’événement tant qu’il n’est pas clôturé.'],
                cancel_attrs: 'data-action="cp--disclosure#close"', token: csrf_token('event_lifecycle_suspendre_' ~ detail.eventId), reason: suspend_reason, problem: problem|default(''),
              } only %}
                {% block fields %}
                  <input type="hidden" name="_token" value="{{ token }}">
                  {% include 'components/field.html.twig' with { id: 'lsuspend-reason', name: 'reason', type: 'textarea', label: 'Motif de la suspension', required: true, value: reason, error: problem, help: 'Obligatoire. Inscrit au journal.' } only %}
                {% endblock %}
              {% endembed %}
            </div>
          {% endif %}
          {% if close and close.allowed %}
            {% set open_count = 0 %}
            {% for d in detail.participants.details %}{% if d.status.value != 'CLOSED' %}{% set open_count = open_count + 1 %}{% endif %}{% endfor %}
            <div data-cp--disclosure-target="panel" data-panel="lclose"{{ open_panel == 'lclose' ? '' : ' hidden' }}>
              {% embed 'components/confirm_panel.html.twig' with {
                id: 'lclose', title: 'Clôturer l’événement', confirm_label: 'Clôturer définitivement', loading_label: 'Clôture…',
                action: path('app_municipal_event_lifecycle', lc|merge({ action: 'cloturer' })),
                consequences: ['La clôture est définitive : l’événement ne pourra plus être réactivé.', open_count ~ (open_count > 1 ? ' participations ouvertes (la vôtre comprise) sont clôturées' : ' participation ouverte (la vôtre) est clôturée') ~ ' en même temps, sans action des communes concernées.'],
                keeps: ['L’événement, ses zones et leur historique restent consultables.'],
                cancel_attrs: 'data-action="cp--disclosure#close"', token: csrf_token('event_lifecycle_cloturer_' ~ detail.eventId), problem: problem|default(''),
              } only %}
                {% block fields %}<input type="hidden" name="_token" value="{{ token }}">{% if problem %}{% include 'components/alert.html.twig' with { variant: 'error', title: 'Clôture impossible', text: problem } only %}{% endif %}{% endblock %}
              {% endembed %}
            </div>
          {% endif %}
        </section>
      {% endif %}
    </div>

    <aside class="cp-stack" aria-label="Synthèse de l’événement">
      {% if life %}
        {% embed 'components/panel.html.twig' with { id: 'life-p', title: 'Cycle de vie', status: status_key, life: life, tz: tz } only %}
          {% block body %}
            {% include 'components/lifecycle.html.twig' with { state: status, dates: {
              draft: 'Créé le ' ~ life.createdAt|cp_datetime(tz),
              active: life.activatedAt ? 'Depuis le ' ~ life.activatedAt|cp_datetime(tz) : '',
              suspended: life.suspendedAt ? 'Suspendu le ' ~ life.suspendedAt|cp_datetime(tz) : '',
              closed: life.closedAt ? 'Clôturé le ' ~ life.closedAt|cp_datetime(tz) : '',
            } } only %}
          {% endblock %}
        {% endembed %}
      {% endif %}
      {% set facts = [
        { label: 'Référence', value: detail.publicReference },
        { label: 'Type', value: detail.typeLabel },
        { label: 'Début', value: detail.startsAt|cp_datetime(tz) },
        { label: 'Fin', value: detail.endsAt ? detail.endsAt|cp_datetime(tz) : 'Non renseignée' },
        { label: 'Fuseau horaire', value: tz },
        { label: 'Organisatrice', value: detail.organizerMunicipalityName },
      ] %}
      {% embed 'components/panel.html.twig' with { id: 'brief-h', title: 'En bref', facts: facts } only %}
        {% block body %}{% include 'components/facts.html.twig' with { items: facts } only %}{% endblock %}
      {% endembed %}
      {% if closure_statistics is defined and closure_statistics %}
        {% include 'municipal/event/_closure_statistics.html.twig' with { stats: closure_statistics } only %}
      {% endif %}
    </aside>
  </div>
{% endblock %}
