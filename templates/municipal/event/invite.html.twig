{% extends 'layouts/app.html.twig' %}

{# Inviter une commune : recherche dans le référentiel national par nom ou code INSEE (dynamique dès 2 caractères, ou GET sans JavaScript), adresse de contact LIBRE, puis envoi de l'invitation (POST). Aucune donnée commerciale. #}
{% set status_key = detail.status.value|lower %}
{% set rel = detail.relation.value %}
{% set tz = detail.timezone %}

{% block content %}
  {% include 'components/breadcrumb.html.twig' with { items: [{ label: 'Événements', href: list_url }, { label: detail.name, href: event_url }, { label: 'Inviter une commune' }], back: { label: detail.name, href: event_url } } only %}
  {% if cstatus %}{% include 'components/commune_status.html.twig' with cstatus only %}{% endif %}
  {% include 'components/page_head.html.twig' with { eyebrow: 'Événement · ' ~ detail.name, title: 'Inviter une commune', sub: 'L’invitation n’expire pas. Un e-mail contenant un lien sécurisé est envoyé à l’adresse de contact indiquée.' } only %}

  {% if summary|length %}{% include 'components/error_summary.html.twig' with { errors: summary } only %}{% endif %}
  {% if alert %}{% include 'components/alert.html.twig' with { variant: 'warning', title: 'Rien n’a été enregistré', text: alert, focus: true } only %}{% endif %}

  <div class="cp-stack" style="gap: var(--space-4)" data-controller="commune-search" data-commune-search-url-value="{{ search_url }}" data-commune-search-min-value="{{ min_length }}">
  <form class="cp-stack" style="gap: var(--space-4)" method="get" action="{{ invite_url }}" aria-label="Rechercher une commune" role="search">
    {% include 'components/search_field.html.twig' with { id: 'insee-q', name: 'q', label: 'Rechercher la commune (nom ou code INSEE)', placeholder: 'Nom ou code INSEE', value: query } only %}
    <p class="cp-help">Saisissez au moins {{ min_length }} caractères : les résultats s’affichent au fil de la frappe.</p>
  </form>

  <form id="invite-form" class="cp-stack" style="gap: var(--space-5)" method="post" action="{{ invite_url }}" novalidate data-controller="cp--unsaved-guard cp--submit-state" tabindex="-1">
    <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
    <input type="hidden" name="q" value="{{ query }}">

    <fieldset class="cp-fieldset" id="invite-candidates">
      <legend class="cp-fieldset__legend">Commune à inviter</legend>
      <div data-commune-search-target="results" aria-live="polite">
        {% include 'municipal/event/_invite_candidates.html.twig' with { found: found, query: query, selected: selected, errors: errors, min_length: min_length } only %}
      </div>
    </fieldset>

    {% include 'components/field.html.twig' with { id: 'inv-contact', name: 'contact_email', type: 'email', label: 'Adresse e-mail du destinataire *', value: contact_email, required: true, error: errors.contact_email|default(''), help: 'Adresse où envoyer l’invitation : celle de la mairie ou d’un référent. Ce n’est pas nécessairement celle du futur administrateur communal.' } only %}

    {% include 'components/field.html.twig' with { id: 'inv-msg', name: 'message', type: 'textarea', label: 'Message', value: message, optional: true, error: errors.message|default(''), help: 'Visible par la commune invitée.' } only %}

    {% include 'components/alert.html.twig' with { variant: 'info', icon: 'shield', title: 'Participation sans abonnement', text: 'Une commune sans abonnement peut être invitée et participer gratuitement à cet événement. Cela ne lui donne pas le droit de créer ses propres événements.' } only %}

    <div class="cp-form-actions">
      {% include 'components/button.html.twig' with { label: 'Envoyer l’invitation', icon: 'mail', type: 'submit', loading_label: 'Envoi…' } only %}
      {% include 'components/button.html.twig' with { label: 'Annuler', variant: 'secondary', href: communes_url } only %}
    </div>
  </form>
  </div>
{% endblock %}
