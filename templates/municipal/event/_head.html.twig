{#
  En-tête commun des pages d'un événement (fiche, communes) : confirmation, erreur, fil d'Ariane, statut de la commune, en-tête, rubriques,
  états. Variables : current (fiche | communes | zones), zone (ZoneView, fiche ou formulaire d'une zone : dernier maillon du fil d'Ariane). Inclus SANS `only` : il lit le contexte de la page.
#}
{% import 'municipal/event/_actions.html.twig' as act %}
  {% for message in app.flashes('success') %}
    {% include 'components/alert.html.twig' with { variant: 'success', title: message, focus: true } only %}
  {% endfor %}
  {% for message in app.flashes('warning') %}
    {% include 'components/alert.html.twig' with { variant: 'warning', title: message, focus: true } only %}
  {% endfor %}
  {% if alert %}{% include 'components/alert.html.twig' with { variant: 'warning', title: 'Rien n’a été enregistré', text: alert, focus: true } only %}{% endif %}
  {% if problem|default('') and not open_panel %}{% include 'components/alert.html.twig' with { variant: 'error', title: 'Action impossible', text: problem, focus: true } only %}{% endif %}
  {% set crumbs = [{ label: 'Événements', href: list_url }] %}
  {% if current == 'fiche' %}
    {% set crumbs = crumbs|merge([{ label: detail.name }]) %}
    {% set back = { label: 'Événements', href: list_url } %}
  {% elseif current == 'communes' %}
    {% set crumbs = crumbs|merge([{ label: detail.name, href: event_url }, { label: 'Communes' }]) %}
    {% set back = { label: detail.name, href: event_url } %}
  {% elseif zone|default(null) %}
    {% set crumbs = crumbs|merge([{ label: detail.name, href: event_url }, { label: 'Zones', href: zones_url }, { label: zone.label }]) %}
    {% set back = { label: 'Zones', href: zones_url } %}
  {% else %}
    {% set crumbs = crumbs|merge([{ label: detail.name, href: event_url }, { label: 'Zones' }]) %}
    {% set back = { label: detail.name, href: event_url } %}
  {% endif %}
  {% include 'components/breadcrumb.html.twig' with { items: crumbs, back: back } only %}
  {% if cstatus %}{% include 'components/commune_status.html.twig' with cstatus only %}{% elseif detail.freeParticipation %}{% include 'components/commune_status.html.twig' with { state: 'free', commune: active_municipality_name } only %}{% endif %}

  {# Relation de la commune active à l'événement et, le cas échéant, raison de la consultation seule. #}
  {% set readonly = detail.readOnlyReason %}
  {% if rel == 'organizer' %}
    {% set relation = { label: 'Organisatrice', variant: 'default', text: 'Votre commune, ' ~ active_municipality_name ~ ', organise cet événement.' } %}
  {% elseif rel == 'participant' %}
    {% set relation = { label: 'Participante', variant: 'default', text: 'Votre commune participe à cet événement organisé par ' ~ detail.organizerMunicipalityName ~ '.' } %}
  {% else %}
    {% set relation = { label: 'Invitée', variant: 'default', text: 'Votre commune est invitée à cet événement par ' ~ detail.organizerMunicipalityName ~ '.' } %}
  {% endif %}
  {% set readonly_text = readonly ? (readonly.value == 'MUNICIPALITY_NOT_WRITABLE' ? 'Votre commune est suspendue : les informations restent consultables.' : 'Votre rôle dans ' ~ active_municipality_name ~ ' ne permet pas de modifier cet événement.') : '' %}

  {% embed 'components/event_header.html.twig' with {
      title: detail.name, type: detail.typeLabel, icon: cp_event_icon(detail.typeCode), status: status_key,
      dates: { start: detail.startsAt|cp_datetime(tz), end: detail.endsAt ? detail.endsAt|cp_datetime(tz) : '' },
      organizer: detail.organizerMunicipalityName, communes: detail.participants.participatingCount, relation: relation, readonly: readonly_text,
      detail: detail, edit_url: edit_url, invite_url: invite_url, current: current, agent_role: agent_role|default(false), new_request_url: new_request_url|default(''),
    } only %}
    {% block actions %}
      {% import 'municipal/event/_actions.html.twig' as act %}
      {{ act.button(detail.visibleAction(constant('App\\Event\\Application\\Read\\EventAction::Update')), 'Modifier', 'settings', 'secondary', edit_url) }}
      {% if current == 'fiche' %}{{ act.button(detail.visibleAction(constant('App\\Event\\Application\\Read\\EventAction::Invite')), 'Inviter une commune', 'mail', 'secondary', invite_url) }}{% endif %}
      {# Proposée seulement à un agent habilité, pour un événement actif dont la participation de la commune est active ; l'écran de saisie revérifie tout. #}
      {% if agent_role|default(false) and detail.status.value == 'ACTIVE' and (detail.relation.value == 'organizer' or (detail.myParticipationStatus and detail.myParticipationStatus.value == 'ACTIVE')) %}
        {% include 'components/button.html.twig' with { id: 'act-new-request', label: 'Nouvelle demande', icon: 'plus', variant: 'secondary', href: new_request_url } only %}
      {% endif %}
    {% endblock %}
  {% endembed %}

  {% include 'components/subnav.html.twig' with { label: 'Rubriques de l’événement', items: [{ label: 'Fiche', href: event_url, current: current == 'fiche' }, { label: 'Communes', href: communes_url, current: current == 'communes' }, { label: 'Zones', href: zones_url, current: current == 'zones' }] } only %}

  {% if status_key == 'suspended' %}
    {% include 'components/alert.html.twig' with { variant: 'warning', title: 'Événement suspendu', text: life and life.suspendedAt ? 'Suspendu le ' ~ life.suspendedAt|cp_datetime(tz) ~ '.' : 'Cet événement est suspendu.' } only %}
  {% elseif status_key == 'closed' %}
    {% include 'components/alert.html.twig' with { variant: 'info', title: 'Événement clôturé', text: life and life.closedAt ? 'Clôturé le ' ~ life.closedAt|cp_datetime(tz) ~ '. Consultation seule.' : 'Cet événement est clôturé. Consultation seule.' } only %}
  {% endif %}

