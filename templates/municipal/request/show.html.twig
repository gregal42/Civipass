{% extends 'layouts/app.html.twig' %}
{% import 'municipal/request/_macros.html.twig' as m %}
{% set tz = detail.timezone %}
{% set modes = { FOOT_BIKE: 'À pied ou à vélo', VEHICLE: 'En véhicule' } %}

{% block content %}
  {% if cstatus %}{% include 'components/commune_status.html.twig' with cstatus only %}{% endif %}
  {% include 'components/breadcrumb.html.twig' with { items: [ { label: 'Demandes', href: requests_url }, { label: detail.eventName, href: list_url }, { label: detail.reference, mono: true } ], back: { label: 'Demandes', href: list_url } } only %}

  {% for message in app.flashes('success') %}{% include 'components/alert.html.twig' with { variant: 'success', title: message, focus: true } only %}{% endfor %}
  {% for message in app.flashes('warning') %}{% include 'components/alert.html.twig' with { variant: 'warning', title: message, focus: true } only %}{% endfor %}

  <header class="cp-dossier-head">
    <p class="cp-eyebrow cp-mono">{{ detail.reference }}</p>
    <h1 class="cp-dossier-head__title">{{ detail.lastName|upper }} {{ detail.firstName }} {% include 'components/status_pill.html.twig' with { status: detail.status.value|lower, label: m.status_label(detail.status.value)|trim, size: 'l' } only %}</h1>
    <div class="cp-dossier-head__meta">
      <span>{% include 'components/icon.html.twig' with { name: 'flag', size: 's' } only %} {{ detail.eventName }}</span>
      <span>{% include 'components/icon.html.twig' with { name: 'clock', size: 's' } only %} Déposée le {{ detail.submittedAt|cp_datetime(tz) }}</span>
    </div>
    {% if detail.participationStatus.value == 'ACTIVE' %}<p class="cp-dossier-head__actions">{% include 'components/button.html.twig' with { label: 'Corriger les informations du bénéficiaire', variant: 'secondary', size: 's', href: identity_url } only %}</p>{% endif %}
    {% if detail.participationStatus.value == 'SUSPENDED' %}
      {% include 'components/banner.html.twig' with { variant: 'warning', text: 'La participation de ' ~ active_municipality_name ~ ' est suspendue : ce dossier reste consultable, en lecture seule.' } only %}
    {% elseif detail.participationStatus.value == 'CLOSED' %}
      {% include 'components/banner.html.twig' with { variant: 'info', text: 'Participation clôturée : historique en lecture seule.' } only %}
    {% endif %}
  </header>

  <div class="cp-dossier__grid" style="margin-top: 20px">
    <div class="cp-dossier__main">
      {% set decision = detail.decision %}
      {% if decision %}
        {% set decision_items = [
          { label: 'Décision', value: decision.outcome.value == 'APPROVED' ? 'Approuvée pour toutes les zones demandées à ' ~ active_municipality_name : 'Refusée pour toutes les zones demandées à ' ~ active_municipality_name },
          { label: 'Décidée par', value: decision.decidedBy },
          { label: 'Le', value: decision.decidedAt|cp_datetime(tz) },
        ] %}
        {% if decision.outcome.value == 'APPROVED' %}
          {% set decision_items = decision_items|merge([
            { label: 'Durée choisie', value: m.duration(decision.durationMode.value)|trim },
            { label: 'Période d’autorisation', value: m.period(decision.validFrom, decision.validUntil, tz)|trim, note: 'Les accès restent limités aux périodes de chaque zone.' },
          ]) %}
        {% else %}
          {% set decision_items = decision_items|merge([{ label: 'Motif du refus', value: decision.refusalReasonLabel }]) %}
          {% if decision.refusalComment %}{% set decision_items = decision_items|merge([{ label: 'Commentaire', value: decision.refusalComment }]) %}{% endif %}
        {% endif %}
        {% embed 'components/panel.html.twig' with { id: 'dec-h', title: 'Décision de ' ~ active_municipality_name, items: decision_items } only %}
          {% block body %}{% include 'components/facts.html.twig' with { items: items } only %}{% endblock %}
        {% endembed %}
      {% else %}
        {% embed 'components/panel.html.twig' with { id: 'dec-h', title: 'Décision de ' ~ active_municipality_name, meta: 'À traiter', can_decide: can_decide, reason: unavailable_reason, approve_url: approve_url, refuse_url: refuse_url } only %}
          {% block body %}
            {% if can_decide %}
              <div class="cp-decision-bar cp-decision-bar--desktop">
                {% include 'components/button.html.twig' with { label: 'Approuver…', variant: 'approve', icon: 'check', size: 'l', href: approve_url } only %}
                <span class="cp-decision-bar__spacer"></span>
                {% include 'components/button.html.twig' with { label: 'Refuser…', variant: 'refuse', icon: 'x', size: 'l', href: refuse_url } only %}
                <p class="cp-decision-bar__hint">La décision porte sur toutes les zones demandées à votre commune ; elle est définitive et ne concerne pas les autres communes.</p>
              </div>
            {% else %}
              <p class="cp-facts__plain">{{ reason }}</p>
            {% endif %}
          {% endblock %}
        {% endembed %}
      {% endif %}

      {% set contact = [{ label: 'Nom', value: detail.lastName }, { label: 'Prénom', value: detail.firstName }] %}
      {% if detail.address %}{% set contact = contact|merge([{ label: 'Adresse', value: detail.address }]) %}{% endif %}
      {% if detail.email %}{% set contact = contact|merge([{ label: 'Adresse e-mail', value: detail.email }]) %}{% endif %}
      {% if detail.phone %}{% set contact = contact|merge([{ label: 'Téléphone', value: detail.phone }]) %}{% endif %}
      {% embed 'components/panel.html.twig' with { id: 'ben-h', title: 'Bénéficiaire', items: contact } only %}
        {% block body %}{% include 'components/facts.html.twig' with { items: items } only %}{% endblock %}
      {% endembed %}

      {% set situation = [{ label: 'Catégorie', value: detail.categoryLabel }, { label: 'Motif', value: detail.motifLabel }] %}
      {% if detail.motifDetail %}{% set situation = situation|merge([{ label: 'Précisions', value: detail.motifDetail }]) %}{% endif %}
      {% embed 'components/panel.html.twig' with { id: 'sit-h', title: 'Situation', items: situation } only %}
        {% block body %}{% include 'components/facts.html.twig' with { items: items } only %}{% endblock %}
      {% endembed %}

      {% set zone_items = detail.zoneViews|map(z => { label: z.label, value: m.validity(z.validityMode.value)|trim ~ (z.suspended ? ' · zone suspendue' : '') }) %}
      {% embed 'components/panel.html.twig' with { id: 'zon-h', title: 'Zones demandées à ' ~ active_municipality_name, items: zone_items } only %}
        {% block body %}{% include 'components/facts.html.twig' with { items: items } only %}{% endblock %}
      {% endembed %}

      {% set plates_html %}{% if detail.plates|length %}<span class="cp-plates">{% for p in detail.plates %}{% include 'components/plate.html.twig' with { number: p } only %}{% endfor %}</span>{% else %}<span class="cp-facts__plain">Sans véhicule</span>{% endif %}{% endset %}
      {% set travel = [{ label: 'Mode de déplacement', value: modes[detail.travelMode.value] }] %}
      {% if detail.travelMode.value == 'VEHICLE' %}{% set travel = travel|merge([{ label: 'Immatriculations', html: plates_html }]) %}{% endif %}
      {% embed 'components/panel.html.twig' with { id: 'dep-h', title: 'Déplacement', items: travel } only %}
        {% block body %}{% include 'components/facts.html.twig' with { items: items } only %}{% endblock %}
      {% endembed %}

      {% embed 'components/panel.html.twig' with { id: 'docs-h', title: 'Justificatifs', meta: detail.attachments|length ? detail.attachments|length ~ (detail.attachments|length > 1 ? ' pièces' : ' pièce') : '', attachments: detail.attachments, urls: download_urls } only %}
        {% block body %}
          {% if attachments|length %}
            <ul class="cp-docs">
              {% for a in attachments %}
                <li class="cp-doc">{% include 'components/icon.html.twig' with { name: 'file' } only %}<p class="cp-doc__name">{{ a.name }}</p><p class="cp-doc__meta">{{ a.typeLabel }} · {{ a.sizeLabel }}</p>
                  <span class="cp-doc__action">{% include 'components/button.html.twig' with { label: 'Télécharger', variant: 'secondary', href: urls[a.id] } only %}</span></li>
              {% endfor %}
            </ul>
          {% else %}
            <p class="cp-facts__plain">Aucun justificatif joint.</p>
          {% endif %}
        {% endblock %}
      {% endembed %}
    </div>
  </div>
{% endblock %}
