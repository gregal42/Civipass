{% extends 'layouts/app.html.twig' %}

{# Inviter un collaborateur (LOT 07.2). Variables : form{email, roles}, error, role_options, csrf, action_url, cancel_url. #}
{% block content %}
  {% include 'components/breadcrumb.html.twig' with { items: [{ label: 'Équipe', href: cancel_url }, { label: 'Inviter un collaborateur' }], back: { label: 'Équipe', href: cancel_url } } only %}
  {% include 'components/page_head.html.twig' with { eyebrow: 'Commune de ' ~ active_municipality_name, title: 'Inviter un collaborateur', sub: 'Un e-mail contenant un lien personnel est envoyé. La personne n’a aucun droit tant qu’elle n’a pas accepté.' } only %}
  {% if error %}{% include 'components/alert.html.twig' with { variant: 'error', title: 'Rien n’a été enregistré', text: error, focus: true } only %}{% endif %}
  <form class="cp-stack" style="gap: var(--space-5)" method="post" action="{{ action_url }}" novalidate data-controller="cp--unsaved-guard cp--submit-state">
    <input type="hidden" name="_token" value="{{ csrf_token(csrf) }}">
    {% include 'components/field.html.twig' with { id: 'team-email', name: 'email', type: 'email', label: 'Adresse e-mail professionnelle *', value: form.email, required: true, autocomplete: 'off', help: 'La personne devra se connecter avec cette adresse précise.' } only %}
    {% include 'municipal/team/_roles_fieldset.html.twig' with { role_options: role_options, selected: form.roles } only %}
    {% include 'components/alert.html.twig' with { variant: 'quiet', icon: 'shield', text: 'Le lien est personnel, valable 7 jours et utilisable une seule fois. L’invité atteste être habilité à représenter la commune.' } only %}
    <div class="cp-form-actions">
      {% include 'components/button.html.twig' with { label: 'Envoyer l’invitation', icon: 'mail', type: 'submit', loading_label: 'Envoi…' } only %}
      {% include 'components/button.html.twig' with { label: 'Annuler', variant: 'secondary', href: cancel_url } only %}
    </div>
  </form>
{% endblock %}
