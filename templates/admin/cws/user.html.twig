{% extends 'admin/cws/base.html.twig' %}
{% block cws_title %}Compte : {{ u.firstName }} {{ u.lastName }}{% endblock %}
{% block cws_content %}
  <div class="box box-primary"><div class="box-body">
    <dl class="dl-horizontal">
      <dt>E-mail</dt><dd>{{ u.email }}</dd>
      <dt>État</dt><dd>{{ u.active ? 'Actif' : 'Désactivé' }}</dd>
      <dt>Dernière connexion</dt><dd>{{ u.lastLoginAt ? u.lastLoginAt|date('d/m/Y H:i', 'Europe/Paris') : 'Jamais' }}</dd>
    </dl>
    <p>
      {% if u.active %}
        <a class="btn btn-warning" href="{{ path('admin_cws_confirm', {action: 'user_deactivate', id: u.id.toRfc4122}) }}">Désactiver le compte</a>
        <a class="btn btn-default" href="{{ path('admin_cws_confirm', {action: 'user_reset', id: u.id.toRfc4122}) }}">Envoyer un lien de réinitialisation</a>
      {% else %}
        <a class="btn btn-success" href="{{ path('admin_cws_confirm', {action: 'user_reactivate', id: u.id.toRfc4122}) }}">Réactiver le compte</a>
      {% endif %}
    </p>
  </div></div>
  <div class="box"><div class="box-header"><h3 class="box-title">Communes rattachées (actives)</h3></div><div class="box-body">
    {% for m in memberships %}
      <p><a href="{{ path('admin_cws_municipality', {id: m.municipality.id.toRfc4122}) }}">{{ m.municipality.name }}</a></p>
    {% else %}
      <p>Aucun rattachement actif.</p>
    {% endfor %}
  </div></div>
{% endblock %}
