{% extends 'admin/cws/base.html.twig' %}
{% block cws_title %}Ouvrir une commune{% endblock %}
{% block cws_content %}
  <div class="box box-primary"><div class="box-body">
    <p>Recherchez la commune dans le référentiel national (nom ou code INSEE). Son nom et son code INSEE viennent de la source officielle : ils ne se saisissent pas. Si la commune existe déjà sur Civipass (par exemple inscrite par une invitation), sa fiche s’ouvre sans doublon.</p>
    <form method="get" action="{{ path('admin_cws_open') }}" class="form-inline">
      <input type="search" name="q" value="{{ query }}" class="form-control" placeholder="Nom ou code INSEE" minlength="{{ min }}" autofocus aria-label="Nom ou code INSEE">
      <button type="submit" class="btn btn-primary">Rechercher</button>
    </form>
  </div></div>
  {% if query is not empty and results is empty %}
    <div class="alert alert-info">Aucune commune du référentiel ne correspond (au moins {{ min }} caractères). Le référentiel est synchronisé par <code>app:communes:sync</code>.</div>
  {% endif %}
  {% if results is not empty %}
    <div class="box"><div class="box-body table-responsive no-padding">
      <table class="table table-bordered table-striped">
        <thead><tr><th>Commune</th><th>Code INSEE</th><th>Département</th><th>Sur Civipass</th><th></th></tr></thead>
        <tbody>
        {% for r in results %}
          <tr>
            <td>{{ r.name }}</td><td>{{ r.inseeCode }}</td><td>{{ r.department }}</td>
            <td>{{ r.registered ? 'Déjà inscrite' : 'Non' }}</td>
            <td>
              <form method="post" action="{{ path('admin_cws_open_do') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('cws_open') }}">
                <input type="hidden" name="insee" value="{{ r.inseeCode }}">
                <button type="submit" class="btn btn-sm btn-success">{{ r.registered ? 'Ouvrir la fiche' : 'Ouvrir cette commune' }}</button>
              </form>
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div></div>
  {% endif %}
{% endblock %}
