{% extends 'layouts/pass.html.twig' %}

{#
  Trop de vérifications depuis cette adresse (429) : AUCUNE donnée, ni variable liée au jeton. Ce n'est pas un refus d'autorisation.
  Variables : minutes (entier, attente indicative).
#}
{% block main_class %}vp-main{% endblock %}

{% block content %}
  <div class="vp-col">
    {% include 'components/alert.html.twig' with { variant: 'warning', title: 'Vérification temporairement indisponible', text: 'Trop de vérifications ont été demandées depuis ce réseau. Ce n’est pas un refus d’autorisation. Patientez environ ' ~ minutes ~ ' minute(s) puis actualisez la page, ou appliquez la procédure de terrain.', role: 'alert' } only %}
    <a class="cp-btn cp-btn--primary cp-btn--l vp-refresh__button" href="" rel="nofollow">{% include 'components/icon.html.twig' with { name: 'refresh' } only %}<span>Actualiser</span></a>
  </div>
{% endblock %}
