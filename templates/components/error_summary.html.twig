{#
  Résumé d’erreurs en tête de formulaire, focalisé à l’affichage ; chaque lien mène au champ concerné.
  @param array errors  Liste de { target (id du champ ou du groupe), message }.
#}
<div class="cp-error-summary" role="alert" tabindex="-1" data-controller="cp--autofocus" aria-labelledby="cp-error-summary-title">
  <b id="cp-error-summary-title">{{ errors|length > 1 ? 'Corrigez ces points avant de confirmer :' : 'Corrigez ce point avant de confirmer :' }}</b>
  <ul>{% for e in errors %}<li><a href="#{{ e.target }}">{{ e.message }}</a></li>{% endfor %}</ul>
</div>
