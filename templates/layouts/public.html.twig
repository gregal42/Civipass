{#
  Gabarit des écrans publics (contrôle QR, portail administré) : sans navigation municipale, sans compte.
  Variables : page_title, connection (online | offline | unreachable), device (bandeau PWA activée).
#}
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <title>{% block title %}{{ page_title }} · Civipass{% endblock %}</title>
  {% block head_meta %}<meta name="turbo-cache-control" content="no-cache">{% endblock %}
  {% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('styles/civipass/tokens.css') }}">
  <link rel="stylesheet" href="{{ asset('styles/civipass/civipass.css') }}">
  <link rel="stylesheet" href="{{ asset('styles/civipass-app.css') }}">
  {% endblock %}
  {% block javascripts %}{{ importmap('app') }}{% endblock %}
</head>
<body class="cp-root">
  <div class="cp-public">
    {% include 'components/public_header.html.twig' with { title: page_title, connection: connection|default(''), device: device|default([]) } only %}
    <main id="main" class="cp-public__main">{% block content %}{% endblock %}</main>
  </div>
  {% include 'components/toasts.html.twig' %}
</body>
</html>
