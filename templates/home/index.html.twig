{% extends 'layouts/auth.html.twig' %}
{% set page_title = 'Accueil' %}

{% block content %}
    {% embed 'components/panel.html.twig' with { id: 'home-h', title: 'Civipass', level: 1 } only %}
        {% block body %}
            {% if app.user %}
                <p>Connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>.</p>
                <form method="post" action="{{ path('app_logout') }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    {% include 'components/button.html.twig' with { label: 'Se déconnecter', type: 'submit', variant: 'secondary', icon: 'logout' } only %}
                </form>
            {% else %}
                <p class="cp-help">Plateforme de gestion des laissez-passer en situation de crise.</p>
                {% include 'components/button.html.twig' with { label: 'Se connecter', href: path('app_login'), size: 'l', block: true } only %}
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endblock %}
