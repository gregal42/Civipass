{% extends 'base.html.twig' %}

{% block title %}Connexion — Civipass{% endblock %}

{% block meta %}
    <meta name="robots" content="noindex, nofollow">
{% endblock %}

{% block body %}
    <div class="page">
        <main class="card">
            <h1>Connexion à Civipass</h1>

            {% if error %}
                <div class="alert" role="alert" id="login-error">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" novalidate>
                <div class="field">
                    <label for="email">Adresse email</label>
                    <input type="email" id="email" name="email" value="{{ last_username }}"
                           autocomplete="username" autocapitalize="none" spellcheck="false"
                           required autofocus
                           {% if error %}aria-invalid="true" aria-describedby="login-error"{% endif %}>
                </div>

                <div class="field">
                    <label for="password">Mot de passe</label>
                    <input type="password" id="password" name="password"
                           autocomplete="current-password" required
                           {% if error %}aria-invalid="true" aria-describedby="login-error"{% endif %}>
                </div>

                <div class="field field--check">
                    <input type="checkbox" id="remember_me" name="_remember_me" aria-describedby="remember-hint">
                    <label for="remember_me">Se souvenir de moi</label>
                    <p class="muted" id="remember-hint">30 jours maximum. À éviter sur un ordinateur partagé.</p>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="button">Se connecter</button>
            </form>

            <p><a href="{{ path('app_forgot_password') }}">Mot de passe oublié ?</a></p>
        </main>
    </div>
{% endblock %}
