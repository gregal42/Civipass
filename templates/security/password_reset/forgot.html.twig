{% extends 'layouts/auth.html.twig' %}
{% set page_title = 'Mot de passe oublié' %}

{% block content %}
    {% embed 'components/panel.html.twig' with { id: 'forgot-h', title: 'Mot de passe oublié', level: 1, error: error|default('') } only %}
        {% block body %}
            <p>Saisissez l’adresse email de votre compte. Si elle correspond à un compte actif, vous recevrez un lien valable 30 minutes pour choisir un nouveau mot de passe.</p>

            {% if error %}
                {% include 'components/alert.html.twig' with { variant: 'error', id: 'form-error', text: error } only %}
            {% endif %}

            <form method="post" action="{{ path('app_forgot_password') }}" novalidate data-controller="cp--submit-state">
                {% include 'components/field.html.twig' with { id: 'email', name: 'email', type: 'email', label: 'Adresse email', required: true, autocomplete: 'username', attrs: 'autofocus autocapitalize="none"' } only %}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">
                {% include 'components/button.html.twig' with { label: 'Envoyer le lien', type: 'submit', size: 'l', block: true, loading_label: 'Envoi…' } only %}
            </form>

            <p class="cp-auth__links"><a href="{{ path('app_login') }}">Retour à la connexion</a></p>
        {% endblock %}
    {% endembed %}
{% endblock %}
