#!/usr/bin/env bash
# Parcours e2e LOCAL « DEUX ORIGINES » du contrôle (LOT 10, V4) : la PWA vit sur l'origine de contrôle (http://localhost:8099) et la gestion sur une autre origine
# (http://127.0.0.1:8099), avec les garde-fous G1 (liste blanche), G2 (hôtes de confiance) et G3 (aucun contrôle sur la gestion) ACTIFS. Même serveur, même application,
# même base de TEST, données fictives, vrai Chrome (protocole DevTools, aucune dépendance), conteneur local éphémère ; aucun déploiement, aucun DNS, aucun certificat.
# Prérequis : Docker, Google Chrome, Node ≥ 22 sur l'hôte. Ne pas lancer en même temps que bin/e2e-control (même port, même base).
set -u
cd "$(dirname "$0")/.."
PHP="${DOCKER_PHP_CONTAINER_NAME:-saas_civipass_php-fpm}"
IMAGE="$(docker inspect "$PHP" --format '{{.Config.Image}}')"
NETWORK="$(docker inspect "$PHP" --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}' | tr ' ' '\n' | grep -v reverse_proxy | head -1)"
PORT=8099
CONTROL="http://localhost:$PORT"      # origine de contrôle (CONTROL_HOST=localhost)
MGMT="http://127.0.0.1:$PORT"         # origine de gestion (DEFAULT_URI)
NAME=saas_civipass_e2e_origins
cleanup() { docker rm -f "$NAME" >/dev/null 2>&1; }
trap cleanup EXIT
cleanup
docker run -d --rm --name "$NAME" --network "$NETWORK" -p "127.0.0.1:$PORT:$PORT" -v "$PWD:/var/www/html" -w /var/www/html \
  -e APP_ENV=test -e APP_DEBUG=1 -e OFFLINE_CONTROL_ENABLED=1 -e PUBLIC_VERIFICATION_ENABLED=1 -e "DEFAULT_URI=$MGMT" \
  -e CONTROL_HOST=localhost -e "CONTROL_PWA_BASE_URL=$CONTROL/controle/" -e 'TRUSTED_HOSTS=^(localhost|127\.0\.0\.1)$' \
  "$IMAGE" php -d variables_order=EGPCS -S "0.0.0.0:$PORT" -t public public/index.php >/dev/null || exit 1
docker exec "$PHP" php bin/console cache:clear --env=test >/dev/null 2>&1
for _ in $(seq 1 40); do
  code="$(curl -s -o /dev/null -w '%{http_code}' "$CONTROL/controle/")"
  [ "$code" = "200" ] && break
  sleep 0.5
done
[ "$code" = "200" ] || { echo "Serveur e2e indisponible (HTTP $code)"; docker logs "$NAME" 2>&1 | tail -5; exit 1; }
SEED="$(docker exec -e "DEFAULT_URI=$MGMT" "$PHP" php tests/Support/e2e-control.php seed 2>/dev/null | tail -1)"
[ -n "$SEED" ] || { echo "Semis impossible"; exit 1; }
E2E_CONTROL="$CONTROL" E2E_MGMT="$MGMT" E2E_SEED="$SEED" E2E_DOCKER_PHP="$PHP" node tests/Js/e2e/control-origins.e2e.mjs
