# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.4.13&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

# Proxys de confiance (adresses séparées par des virgules) : vide par défaut = aucun (production derrière Nginx seul). Développement : voir .env.local et docs/authentication.md.
# SYMFONY_TRUSTED_PROXIES=

# Contrôle public `/v/{jeton}` (LOT 05.4.2) : 0 = désactivé (404 uniforme, aucune lecture), 1 = actif. JAMAIS activé sans accord du responsable du projet.
PUBLIC_VERIFICATION_ENABLED=0

# Contrôle hors connexion (LOT 09) : 0 = désactivé (404 uniforme sur /controle/*), 1 = actif. JAMAIS activé sans accord du responsable du projet.
OFFLINE_CONTROL_ENABLED=0

# Information des demandeurs refusés par e-mail (LOT 08.5, DM-136) : 0 = envoi désactivé (le libellé juridique du message doit être validé avant tout envoi réel), 1 = actif.
REFUSAL_NOTICE_ENABLED=0
# Plafond de configuration du seuil dur de confiance hors ligne, en secondes (pilote : 43200 = 12 h ; plafond technique absolu 86400). Le relever = décision explicite.
# CONTROL_TRUST_HARD_MAX_SECONDS=43200
# CONTROL_TRUST_WARN_SECONDS=21600
# Plafonds provisoires de la limitation de débit de ce contrôle (par IP ; IPv6 : /64). Valeurs par défaut : 1 500 consultations / 10 min (garde-fou
# contre l'inondation, applicable à tout jeton), 20 jetons inconnus / 15 min (ne touche jamais un jeton valide) ; config/services.yaml, DT-055.
# Décommenter pour les modifier.
# VERIFICATION_ACCESS_LIMIT=1500
# VERIFICATION_FAILURE_LIMIT=20

###> civipass/notifications ###
# Chiffrement des secrets bénéficiaires (LOT 05.3.2). JAMAIS de clé dans ce fichier : définir dans .env.local ou l'environnement du serveur.
# NOTIFICATION_KEYRING="identifiant:clé_base64[,identifiant:clé_base64]" (32 octets par clé) ; NOTIFICATION_ACTIVE_KEY_ID = clé qui chiffre.
# Générer une clé : php -r 'echo base64_encode(sodium_crypto_aead_xchacha20poly1305_ietf_keygen()), PHP_EOL;'. Vérifier : bin/console app:notifications:check-crypto
NOTIFICATION_KEYRING=
NOTIFICATION_ACTIVE_KEY_ID=
# SEC-006 : clé DÉDIÉE des secrets TOTP (même format que NOTIFICATION_KEYRING). Vide en développement : repli sur APP_SECRET. Obligatoire en production.
TWO_FACTOR_KEYRING=
TWO_FACTOR_ACTIVE_KEY_ID=
# SEC-020 : clé DÉDIÉE de la copie scellée des jetons de contrôle (même format). Vide en développement : repli sur APP_SECRET. Obligatoire en production.
PERMIT_TOKEN_KEYRING=
PERMIT_TOKEN_ACTIVE_KEY_ID=
###< civipass/notifications ###
